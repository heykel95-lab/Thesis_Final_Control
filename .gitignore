# Build artefacts
surface_grinding_controller/build/
surface_grinding_controller/surface_grinding_controller
surface_grinding_controller/tools/measure_plane
surface_grinding_controller/tools/measure_tool_axis
*.o
__pycache__/

# Live controller output. run.sh moves these into experiments/results/ as part
# of archiving a trial, so what is left here is an unarchived run.
surface_grinding_controller/logs/

# Raw 1 kHz trial logs, about 7.7 MB each. The campaign would put half a
# gigabyte of them in the history. They stay on disk and are archived
# separately; what is tracked is the set-up report in terminal.log, the
# effective parameters, the figures, and the extracted metrics.
experiments/results/**/*.csv

# Regenerated from the archives by analysis/extract_metrics.py.
experiments/derived/

# Local agent settings
.claude/settings.local.json

# Superseded campaign, kept on disk because the raw logs are not tracked.
experiments/results_prior/
